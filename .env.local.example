NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Necessária apenas no webhook do Stripe (server-only, nunca expor ao browser)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL pública do site, usada para montar as URLs de retorno do Stripe Checkout
# e a metadataBase (Open Graph) do site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp (com DDI+DDD, só dígitos) do botão flutuante da landing page
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
